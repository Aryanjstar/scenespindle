# Copy to .env.local (local) or .env.production (docker compose). Never commit real values.

# App
APP_ORIGIN=http://localhost:3000          # exact public origin; mutations from any other origin are refused
OWNER_EMAIL=                              # the one owner account (invites, reset links)
AUTH_TOKEN_PEPPER=                        # 32+ random bytes, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Database: MongoDB replica set (Atlas works). The app refuses MONGODB_DB=leela outside production.
MONGODB_URI=
MONGODB_DB=leela-dev

# Storage: local disk shared by web and worker (same machine or shared volume)
STORAGE_DIR=.data/media
VOICE_CACHE_DIR=.data/cache/voice
RENDER_WORK_DIR=.data/work
RENDER_QUALITY=draft                      # draft | standard | high

# Mail (optional). Without it, invites and resets are copy-a-link flows.
RESEND_API_KEY=
MAIL_FROM="SceneSpindle <studio@example.com>"

# Planner
GEMINI_API_KEY=

# Voices. A narrator is selectable only when its key is set.
# If the chosen voice is out of credits, the film uses another configured voice and says who spoke.
AZURE_SPEECH_KEY=                         # Indian English and Hindi house voices (Neerja, Prabhat, Swara, Madhur)
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_MONTHLY_CHARS=500000
ELEVENLABS_API_KEY=                       # free tier is non-commercial; films are labelled so
ELEVENLABS_MONTHLY_CHARS=10000            # studio-side allowance; work pauses when used up
SARVAM_API_KEY=
SARVAM_MONTHLY_CHARS=20000

# Images for Story, Cartoon and character sheets (Azure OpenAI gpt-image deployment)
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_KEY=
AZURE_IMAGE_DEPLOYMENT=gpt-image
IMAGE_MONTHLY_IMAGES=300

# Storage driver: local (default) or azure
# STORAGE_DRIVER=azure
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=media

# Proxy hops to trust for client IPs in rate limits (Azure Container Apps ingress = 1; local = 0)
TRUST_PROXY_HOPS=1

# Transcription for reel captions and karaoke lyrics. ElevenLabs Scribe uses ELEVENLABS_API_KEY;
# whisper.cpp is used when installed (and as the fallback when the hosted service is unavailable).
WHISPER_CLI=whisper-cli
WHISPER_MODEL=                            # path to a ggml model, e.g. ggml-base.bin

# Paired PCs only: Blender for the cinematic 3D profile (auto-detected on macOS)
BLENDER_BIN=

# Optional internals: APP_VERSION (set by deploy), KEEP_RENDER_WORK=1 keeps render folders for debugging,
# OWNER_NAME (create-owner), STUDIO_URL and STUDIO_TOKEN (remote CLI and MCP clients),
# AZURE_STORAGE_ENDPOINT (custom blob endpoint), HF_CREDENTIALS (scripts only).

# Pipeline test voice (sine tone). Leave unset in production.
SCENESPINDLE_TEST_VOICE=

# Publishing to YouTube and Instagram is not built yet; these are reserved:
# TOKEN_ENC_KEY= YOUTUBE_CLIENT_ID= YOUTUBE_CLIENT_SECRET= META_APP_ID= META_APP_SECRET=
